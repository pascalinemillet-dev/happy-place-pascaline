# Copie ce fichier en .env puis remplace les deux valeurs par celles de TON projet Supabase
# (Supabase > Project Settings > API, ou bouton « Connect » en haut du tableau de bord).
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# F1 (optionnel) : IA pour le titre d'un point bloquant (US31) et le récap du point d'équipe (US64).
# Le Worker envoie les données minimisées au scénario Make « HappyPlace - IA », qui appelle OpenAI.
# Variables lues côté serveur seulement, jamais envoyées au navigateur : ne pas les préfixer par VITE_.
# Sur Cloudflare : Workers > happy-place-pascaline > Settings > Variables and Secrets (type Secret).
# Sans MAKE_AI_WEBHOOK_URL, l'IA est désactivée : le titre se saisit à la main et le récap s'affiche en tableau.
# MAKE_AI_WEBHOOK_URL="https://hook.eu2.make.com/xxxxxxxxxxxxxxxx"
# MAKE_AI_SECRET="une-longue-chaine-aleatoire"
